NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public app URL used for gateway callback URLs. Use your deployed HTTPS URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SSLCommerz hosted checkout. Keep these as local/deployment secrets only.
SSLCOMMERZ_MODE=sandbox
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
SSLCOMMERZ_DEFAULT_CUSTOMER_EMAIL=payments@example.com
